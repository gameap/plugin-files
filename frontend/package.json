{
  "name": "plugin-files-frontend",
  "version": "0.6.0",
  "description": "GameAP Files Plugin Frontend - FTP/SFTP Users Management",
  "type": "module",
  "main": "./dist/plugin.js",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "debug": "PLUGIN_PATH=./dist npx @gameap/debug",
    "dev:hmr": "concurrently -k -n build,debug,sync -c blue,green,yellow \"npm:dev\" \"npm:debug\" \"npx browser-sync start --proxy localhost:5174 --port 5175 --files dist/plugin.js,dist/*.css --no-open --no-notify\"",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gameap/plugin-sdk": "file:../../gameap-api/web/plugin-sdk"
  },
  "devDependencies": {
    "@gameap/debug": "file:../../gameap-api/web/frontend/packages/gameap-debug",
    "@vitejs/plugin-vue": "^6.0.1",
    "axios": "^1.19.0",
    "browser-sync": "^3.0.4",
    "concurrently": "^9.2.1",
    "naive-ui": "^2.44.1",
    "typescript": "^5.3.0",
    "vite": "^7.1.0",
    "vitest": "^3.0.0",
    "vue": "^3.5.22",
    "vue-router": "^4.6.4",
    "vue-tsc": "^2.0.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
